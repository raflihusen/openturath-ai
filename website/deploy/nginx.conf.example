# Replace domain, certificates and paths before use. This is not active configuration.
server {
    listen 443 ssl;
    server_name openturath.id;
    ssl_certificate /etc/letsencrypt/live/openturath.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/openturath.id/privkey.pem;
    root /srv/openturath/current/dist;
    index index.html;
    client_max_body_size 50k;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
    location / { try_files $uri $uri/ =404; }
    location = /api/reports {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Origin $http_origin;
        proxy_read_timeout 20s;
        access_log off;
    }
    location /api/ { return 404; }
    location ~ /\. { deny all; }
    error_page 404 /404.html;
    location = /404.html { internal; }
}
server {
    listen 80;
    server_name openturath.id;
    return 301 https://openturath.id$request_uri;
}
