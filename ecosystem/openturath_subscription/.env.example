# ──────────────────────────────────────────────────────────────────────
# OpenTurath Subscription Automation — Konfigurasi
# ──────────────────────────────────────────────────────────────────────
# Salin file ini ke .env dan isi nilainya.
# ⚠️  JANGAN commit file .env ke Git!

# ─── Akal API ────────────────────────────────────────────────────────
# Dari: goakal.com → Developer → API Keys (scope: external_api)
AKAL_API_KEY=ak_isi_api_key_dari_akal_disini

# Dari: goakal.com → Developer → Webhook → Verification Token
AKAL_WEBHOOK_SECRET=isi_webhook_verification_token_dari_akal

# ─── Akal Service CUIDs ──────────────────────────────────────────────
# Dari URL Akal atau dari: GET /services
# Contoh URL: goakal.com/openturath/ai-fikih → cuid ada di response API
# Gunakan: curl https://goakal.com/service/api/v1/services -H "X-Api-Key: ak_..."
AKAL_SERVICE_CUID_FIKIH_TAHAWWULAT=clxxx_isi_cuid_service_fikih
AKAL_SERVICE_CUID_HADITS=clxxx_isi_cuid_service_hadits
AKAL_SERVICE_CUID_TAFSIR=clxxx_isi_cuid_service_tafsir

# ─── NotebookLM Notebook IDs ─────────────────────────────────────────
# Dari URL NotebookLM: notebooklm.google.com/notebook/<ID_INI>
NOTEBOOK_ID_FIKIH_TAHAWWULAT=paste_notebook_id_fikih_tahawwulat_disini
NOTEBOOK_ID_HADITS=paste_notebook_id_hadits_disini
NOTEBOOK_ID_TAFSIR=paste_notebook_id_tafsir_disini

# ─── Server Config ───────────────────────────────────────────────────
PORT=8080

# ─── Untuk manual_sync.py (testing) ──────────────────────────────────
# TEST_NOTEBOOK_ID=paste_notebook_id_untuk_test_disini
