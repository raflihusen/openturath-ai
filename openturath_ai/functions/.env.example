# ================================================================
# OpenTurath AI - Cloud Functions Environment Configuration Template
# ================================================================
# SALIN file ini menjadi .env pada direktori functions/
# JANGAN PERNAH meng-commit file .env yang berisi kunci rahasia nyata ke Git!

# GoAkal & Service API Key
AKAL_API_KEY=your_akal_api_key_here

# Cookie Secret (Min 32 karakter hex acak) untuk session web
COOKIE_SECRET=your_32_byte_random_cookie_secret_here
WEB_SESSION_SECRET=your_32_byte_random_cookie_secret_here

# Internal Secret untuk handshake antar-service
INTERNAL_SECRET=your_internal_service_secret_here

# DOKU Payment Gateway Credentials
DOKU_ENV=sandbox
DOKU_CLIENT_ID=your_doku_client_id_here
DOKU_SECRET_KEY=your_doku_secret_key_here
DOKU_API_KEY=your_doku_api_key_here
DOKU_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_DOKU_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
