[Unit]
Description=OpenTurath verified subscription and replica access worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/openturath-access/releases/current
Environment=GOOGLE_CLOUD_PROJECT=open-turath
Environment=GOOGLE_APPLICATION_CREDENTIALS=/home/ubuntu/openturath-access/secrets/firestore-key.json
Environment=NOTEBOOKLM_STORAGE_PATH=/home/ubuntu/openturath-access/secrets/storage_state.json
Environment=ACCESS_NOTEBOOKLM_CLI=/home/ubuntu/openturath-access/venv/bin/notebooklm
Environment=ACCESS_OWNER_EMAIL=raflimaulan@gmail.com
Environment=ACCESS_PYTHON=/home/ubuntu/openturath-access/venv/bin/python
# Adapter ships inside the release so it always matches the worker version.
Environment=ACCESS_SHARING_ADAPTER=/home/ubuntu/openturath-access/releases/current/verified_sharing.py
Environment=NODE_ENV=production
# Optional overrides (e.g. ACCESS_OWNER_EMAIL); credentials stay in secrets/.
EnvironmentFile=-/home/ubuntu/openturath-access/secrets/worker.env
ExecStart=/usr/bin/node /home/ubuntu/openturath-access/releases/current/lib/access_worker.js
Restart=always
RestartSec=10
TimeoutStopSec=120
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/openturath-access
UMask=0077
MemoryMax=600M
CPUQuota=50%
Nice=10

[Install]
WantedBy=multi-user.target
