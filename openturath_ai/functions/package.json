{
  "name": "openturath-functions",
  "version": "1.0.0",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "npm run build && firebase deploy --only functions",
    "test": "cd .. && node --test --experimental-transform-types functions/test/*.test.ts",
    "check": "tsc --noEmit",
    "export-shared": "npm run build && node tool/export_shared.cjs",
    "scrub-vip": "node tool/scrub_vip_registry.cjs"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "firebase-admin": "^12.2.0",
    "firebase-functions": "^5.0.1",
    "googleapis": "^173.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.5"
  }
}
