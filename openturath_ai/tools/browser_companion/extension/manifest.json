{
  "manifest_version": 3,
  "name": "OpenTurath Browser Companion",
  "description": "Menghubungkan percakapan OpenTurath dengan sesi NotebookLM milik pengguna di Chrome.",
  "version": "0.1.0",
  "minimum_chrome_version": "105",
  "key": "",
  "permissions": ["nativeMessaging"],
  "host_permissions": [
    "https://notebooklm.google.com/*",
    "https://notebook.google.com/*"
  ],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Hubungkan OpenTurath"},
  "content_scripts": [
    {
      "matches": [
        "https://notebooklm.google.com/*",
        "https://notebook.google.com/*"
      ],
      "js": ["notebook_protocol.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
